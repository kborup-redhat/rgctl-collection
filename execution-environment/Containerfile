ARG RGCTL_VERSION=0.4.26
ARG BASE_IMAGE=registry.redhat.io/ansible-automation-platform/ee-minimal-rhel9:latest

FROM ${BASE_IMAGE}

ARG RGCTL_VERSION

# Install rgctl at image build time — do not download at playbook runtime in AAP
RUN TARBALL="rgctl-${RGCTL_VERSION}-x86_64-unknown-linux-gnu.tar.gz" && \
    curl -fsSL \
      "https://github.com/rgctl/rgctl/releases/download/v${RGCTL_VERSION}/${TARBALL}" \
      -o "/tmp/${TARBALL}" && \
    curl -fsSL \
      "https://github.com/rgctl/rgctl/releases/download/v${RGCTL_VERSION}/SHA256SUMS.txt" \
      -o /tmp/SHA256SUMS.txt && \
    cd /tmp && \
    sha256sum -c SHA256SUMS.txt --ignore-missing && \
    tar xzf "${TARBALL}" && \
    install -m 755 rgctl /usr/local/bin/rgctl && \
    rm -f "/tmp/${TARBALL}" /tmp/SHA256SUMS.txt /tmp/rgctl

RUN rgctl --version
